{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "module": "CommonJS", // <- ini penting supaya ts-node jalan di Node 22
    "target": "ES2020",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "paths": {
      "@/*": ["./*"]
    },
    "outDir": "dist"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "scripts/**/*.ts" // <- supaya ts-node kenal scripts/
  ]
}
