{
    "expo": {
        "name": "Gereja Santa Clara",
        "slug": "SantaClaraApp2",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/Logo-Santa-Clara-Bekasi-Transparant-SMALL.png",
        "scheme": "santaclaraapp2",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "backgroundImage": "./assets/images/android-icon-background.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false,
            "package": "com.anonymous.SantaClaraApp2",
            "intentFilters": [{
                "action": "VIEW",
                "data": [{
                    "scheme": "santaclaraapp2",
                    "host": "reset-password"
                }],
                "category": ["BROWSABLE", "DEFAULT"]
            }]
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router", [
                "expo-splash-screen",
                {
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff",
                    "dark": {
                        "backgroundColor": "#000000"
                    }
                }
            ],
            "@react-native-community/datetimepicker"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "77f8aacc-9d8a-49a5-aba4-7618de479c92"
            }
        },
        "owner": "sandysukma"
    }
}